# campaignlymedia.com: Apache / LiteSpeed configuration for the static export in public_html.

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8

# ---------- Error pages ----------
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---------- Force HTTPS ----------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://campaignlymedia.com%{REQUEST_URI} [L,R=301,NE]

  # ---------- Force one host (non-www) ----------
  RewriteCond %{HTTP_HOST} ^www\.campaignlymedia\.com$ [NC]
  RewriteRule ^ https://campaignlymedia.com%{REQUEST_URI} [L,R=301,NE]

  # ---------- Old site redirects (see docs/redirects.md) ----------
  # Add one line per old URL, above the trailing-slash rules, for example:
  # RewriteRule ^old-page/?$ /services/meta-ads/ [L,R=301]
  # BEGIN REDIRECTS
  RewriteRule ^case-study-1(\.html|\.php)?/?$ /case-studies/service-business-lead-cost/ [L,R=301]
  RewriteRule ^case-study-2(\.html|\.php)?/?$ /case-studies/ecommerce-meta-ads-roas/ [L,R=301]
  RewriteRule ^case-study-3(\.html|\.php)?/?$ /case-studies/saas-google-ads-conversions/ [L,R=301]
  RewriteRule ^case-study-4(\.html|\.php)?/?$ /case-studies/b2b-full-funnel-revenue/ [L,R=301]
  RewriteRule ^case-study-5(\.html|\.php)?/?$ /case-studies/ecommerce-conversion-rate/ [L,R=301]
  RewriteRule ^privacy(\.html|\.php)?/?$ /privacy-policy/ [L,R=301]
  RewriteRule ^meta-ads-agency(\.html|\.php)?/?$ /services/meta-ads/ [L,R=301]
  RewriteRule ^google-ads-agency(\.html|\.php)?/?$ /services/google-ads/ [L,R=301]
  RewriteRule ^seo-agency(\.html|\.php)?/?$ /services/seo/ [L,R=301]
  RewriteRule ^lead-generation-agency(\.html|\.php)?/?$ /services/ [L,R=301]
  RewriteRule ^social-media-marketing-agency(\.html|\.php)?/?$ /services/social-media/ [L,R=301]
  RewriteRule ^performance-marketing-agency(\.html|\.php)?/?$ /services/ [L,R=301]
  RewriteRule ^meta-ads-vs-google-ads(\.html|\.php)?/?$ /blog/meta-ads-vs-google-ads-for-lead-generation/ [L,R=301]
  RewriteRule ^seo-vs-paid-ads(\.html|\.php)?/?$ /services/seo/ [L,R=301]
  RewriteRule ^lead-generation-vs-brand-awareness(\.html|\.php)?/?$ /services/brand-strategy/ [L,R=301]
  RewriteRule ^facebook-ads-vs-instagram-ads(\.html|\.php)?/?$ /services/meta-ads/ [L,R=301]
  RewriteRule ^performance-marketing-vs-digital-marketing(\.html|\.php)?/?$ /blog/how-to-choose-a-performance-marketing-agency/ [L,R=301]
  RewriteRule ^industries/education-marketing(\.html|\.php)?/?$ /industries/education/ [L,R=301]
  RewriteRule ^industries/real-estate-marketing(\.html|\.php)?/?$ /industries/real-estate/ [L,R=301]
  RewriteRule ^industries/healthcare-marketing(\.html|\.php)?/?$ /industries/healthcare/ [L,R=301]
  RewriteRule ^industries/ecommerce-marketing(\.html|\.php)?/?$ /industries/ecommerce-d2c/ [L,R=301]
  RewriteRule ^industries/automotive-marketing(\.html|\.php)?/?$ /industries/ [L,R=301]
  RewriteRule ^industries/local-business-marketing(\.html|\.php)?/?$ /industries/ [L,R=301]
  RewriteRule ^industries/coaching-institute-marketing(\.html|\.php)?/?$ /industries/education/ [L,R=301]
  RewriteRule ^industries/hospitality-marketing(\.html|\.php)?/?$ /industries/hospitality/ [L,R=301]
  RewriteRule ^industries/clinic-marketing(\.html|\.php)?/?$ /industries/healthcare/ [L,R=301]
  RewriteRule ^industries/car-detailing-marketing(\.html|\.php)?/?$ /industries/ [L,R=301]
  RewriteRule ^industries/event-marketing(\.html|\.php)?/?$ /industries/ [L,R=301]
  RewriteRule ^blog/how-much-should-a-business-spend-on-meta-ads(\.html|\.php)?/?$ /services/meta-ads/ [L,R=301]
  RewriteRule ^blog/meta-ads-vs-google-ads-lead-generation(\.html|\.php)?/?$ /blog/meta-ads-vs-google-ads-for-lead-generation/ [L,R=301]
  RewriteRule ^blog/best-digital-marketing-strategy-for-local-businesses(\.html|\.php)?/?$ /blog/ [L,R=301]
  RewriteRule ^blog/how-to-generate-high-quality-leads-using-paid-ads(\.html|\.php)?/?$ /blog/meta-lead-ads-low-quality-leads/ [L,R=301]
  RewriteRule ^blog/why-your-facebook-ads-are-not-converting(\.html|\.php)?/?$ /services/meta-ads/ [L,R=301]
  RewriteRule ^blog/how-seo-helps-local-businesses-get-more-leads(\.html|\.php)?/?$ /services/seo/ [L,R=301]
  RewriteRule ^blog/how-to-choose-a-digital-marketing-agency(\.html|\.php)?/?$ /blog/how-to-choose-a-performance-marketing-agency/ [L,R=301]
  RewriteRule ^blog/best-marketing-strategy-for-real-estate-businesses(\.html|\.php)?/?$ /industries/real-estate/ [L,R=301]
  RewriteRule ^blog/best-marketing-strategy-for-education-brands(\.html|\.php)?/?$ /industries/education/ [L,R=301]
  RewriteRule ^blog/best-marketing-strategy-for-clinics(\.html|\.php)?/?$ /industries/healthcare/ [L,R=301]
  RewriteRule ^blog/how-to-run-google-ads-for-service-businesses(\.html|\.php)?/?$ /services/google-ads/ [L,R=301]
  RewriteRule ^blog/what-is-performance-marketing(\.html|\.php)?/?$ /blog/how-to-choose-a-performance-marketing-agency/ [L,R=301]
  RewriteRule ^blog/what-is-a-sales-funnel(\.html|\.php)?/?$ /services/landing-pages/ [L,R=301]
  RewriteRule ^blog/how-to-improve-landing-page-conversion-rate(\.html|\.php)?/?$ /services/landing-pages/ [L,R=301]
  RewriteRule ^blog/why-retargeting-is-important(\.html|\.php)?/?$ /services/meta-ads/ [L,R=301]
  RewriteRule ^blog/how-much-do-google-ads-cost(\.html|\.php)?/?$ /services/google-ads/ [L,R=301]
  RewriteRule ^blog/how-much-do-meta-ads-cost(\.html|\.php)?/?$ /services/meta-ads/ [L,R=301]
  RewriteRule ^blog/best-digital-marketing-channels-for-small-businesses(\.html|\.php)?/?$ /blog/ [L,R=301]
  RewriteRule ^blog/how-to-track-leads-from-ads(\.html|\.php)?/?$ /blog/what-should-a-marketing-agency-report-include/ [L,R=301]
  RewriteRule ^blog/how-to-scale-paid-ads-profitably(\.html|\.php)?/?$ /blog/how-many-ad-creatives-to-test/ [L,R=301]
  RewriteRule ^location/(dubai|business-bay|dubai-marina|abu-dhabi|sharjah)(/.*)?$ /locations/uae/ [L,R=301]
  RewriteRule ^location/(new-york|los-angeles|miami|chicago|san-francisco)(/.*)?$ /locations/usa/ [L,R=301]
  RewriteRule ^location/(toronto|vancouver|montreal|calgary)(/.*)?$ /locations/canada/ [L,R=301]
  RewriteRule ^location/(mumbai|delhi|bangalore|jaipur|gurugram|noida|pune)(/.*)?$ /locations/india/ [L,R=301]
  RewriteRule ^location/(lane-cove|north-sydney|chatswood|manly|cronulla|parramatta|bondi|surry-hills|melbourne-cbd|south-yarra|brisbane-cbd|gold-coast|perth-cbd)(/.*)?$ /locations/ [L,R=301]
  RewriteRule ^location/?$ /locations/ [L,R=301]
  # Old server scripts and dumps: always gone, never served
  RewriteRule ^(db|install|contact|generate-pages)\.php$ - [G,L]
  RewriteRule ^gen\.py$ - [G,L]
  RewriteRule \.sql$ - [G,L]
  RewriteRule ^admin(/.*)?$ - [G,L]
  # END REDIRECTS

  # ---------- index.html -> folder URL ----------
  RewriteCond %{THE_REQUEST} \s/+(.+/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301,NE]

  # ---------- Trailing slash consistency ----------
  # Add a slash to extensionless paths that map to a folder with index.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ /$1/ [L,R=301,NE]
</IfModule>

# ---------- Compression ----------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# ---------- MIME types ----------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType text/plain .txt
  AddType application/xml .xml
</IfModule>

# ---------- Caching ----------
<IfModule mod_headers.c>
  # HTML and route payloads: always revalidate so deploys appear immediately.
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # OG images and icons change rarely but are not hashed.
  <FilesMatch "\.(png|jpg|jpeg|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # JS, CSS and fonts are only emitted under /_next/static/ with content hashes: cache for a year.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

# ---------- Block dotfiles except .well-known ----------
<IfModule mod_rewrite.c>
  RewriteRule "(^|/)\.(?!well-known/)" - [F]
</IfModule>
